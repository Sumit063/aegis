# Template for <deploy root>/<env>/.env on a server. deploy.sh creates it on first deploy of an
# environment (mode 600) with a generated database password and the environment's ports.
# Each environment keeps its OWN secrets here: gateway keys, webhook secrets, signing secrets.
# Never commit a real .env.
SPRING_PROFILES_ACTIVE=dev
POSTGRES_PASSWORD=change-me
AEGIS_IMAGE=ghcr.io/sumit063/aegis
AEGIS_HTTP_PORT=8280
AEGIS_MANAGEMENT_PORT=8281
